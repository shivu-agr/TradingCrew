# Copy this file to `.env` and fill in your own values.  `.env` is
# git-ignored — never commit real keys.

# =============================================================================
# Primary LLM — any OpenAI-compatible vLLM-style endpoint.  Preferred when
# all three values below are set.  Pick a long-context model (~131K) if
# you plan to use the full 8-analyst debate flow — the bull / bear /
# research-manager prompts include every analyst report and can easily
# reach 30-50K tokens before the LLM responds.
# =============================================================================
VLLM_LLM_BASE_URL=
VLLM_LLM_MODEL=
VLLM_LLM_API_KEY=

# =============================================================================
# Fallback LLM — local vLLM (only used if the VLLM_LLM_* vars above are
# unset).  Run e.g. `vllm serve <model> --port 8081 --tool-call-parser hermes`.
# OPENAI_API_KEY must be set to any non-empty string — vLLM's OpenAI-compatible
# server ignores the value but its client library requires the header.
# =============================================================================
LOCAL_LLM_BASE_URL=http://localhost:8081/v1
LOCAL_LLM_MODEL=
OPENAI_API_KEY=dummy

# Provider prefix used in the model string (CrewAI/LiteLLM convention):
#   hosted_vllm  -> vLLM-style server (default — both endpoints above are vLLM)
#   ollama_chat  -> local Ollama
#   openai       -> any other OpenAI-compatible server (needs litellm extra)
LLM_PROVIDER_PREFIX=hosted_vllm

# =============================================================================
# LLM robustness knobs (Phase 2G — Gemma-4 stall fix).
#
# LLM_TIMEOUT_SECONDS — bounded read-timeout per call.  Default 720s (12 min)
# leaves headroom for slow Gemma-4 / OSS-120B generations on a contended GPU
# but eventually surfaces a true hang as a `[[DEGRADED_LLM_TIMEOUT]]` report
# rather than blocking the whole workflow.  Tighten on fast closed-source
# endpoints (~60-120s) if you want quicker feedback on flaky requests.
#
# LLM_MAX_RETRIES — how many times the OpenAI SDK retries a failed call.
# The SDK default is 2, but on a local OpenAI-compatible server (e.g. vLLM)
# each retry opens a NEW HTTP connection without telling the server the
# previous request was abandoned.  vLLM keeps decoding tokens for the
# orphaned call as a "zombie request" that competes for GPU decode slots
# with the live one, which makes the stall *worse* over time.  We default
# to 0 so a single failed call is converted to a degraded placeholder
# and the run keeps moving instead of accumulating zombies.  Bump back
# to 1-2 on flaky network transports if needed.
#
# ``max_tokens`` is intentionally NOT capped — capping it truncates analyst
# reports below their prompted length budget; vLLM's server-side default
# (max_model_len minus prompt tokens) is the right ceiling.
# =============================================================================
LLM_TIMEOUT_SECONDS=720
LLM_MAX_RETRIES=0

# =============================================================================
# Closed-source LLM API keys (optional) — only required if you enable the
# corresponding preset in the UI's LLM dropdown.  The picker greys out
# closed-source options whose key isn't set, so leaving these blank just
# means those presets are unavailable.
# =============================================================================
# Used by `openai-gpt-4o-mini` and `openai-gpt-4o` UI presets.  Kept SEPARATE
# from OPENAI_API_KEY=dummy above (which the local vLLM client requires as a
# placeholder).
OPENAI_PROD_API_KEY=
# Used by `anthropic-claude-sonnet`.
ANTHROPIC_API_KEY=

# Default UI preset id (matches `trading_crew/llm_presets.py::BUILTIN_PRESETS`).
# Users can still override per-run via the sidebar dropdown.
TRADINGCREW_DEFAULT_LLM_PRESET=hosted-vllm-oss

# =============================================================================
# Embedding endpoint — used by CrewAI's native memory (short/long/entity).
# Required when memory is enabled, unless the user picks a closed-source
# embedding preset (e.g. `openai-text-embedding-3-small`) from the UI.
# Any OpenAI-compatible embedding server works.
# =============================================================================
VLLM_EMBEDDING_BASE_URL=
VLLM_EMBEDDING_MODEL=
VLLM_EMBEDDING_API_KEY=

# Per-document character budget passed to the embedder.  Small models like
# `embeddinggemma-300m` cap inputs at 2048 tokens.  Memory writes (PM
# rationale + analyst summaries) can exceed that and surface as a confusing
# "400 - maximum context length is 2048 tokens" right after the Portfolio
# Manager.  The default 6000 (~1500 tokens) keeps a safe margin; bump it
# only if you switch to a larger-window embedder (the OpenAI embedding
# presets ship 24000 as their default — that's a model-aware sensible
# value, but setting this env var clamps it tighter).
TRADINGCREW_EMBEDDER_MAX_CHARS=6000

# Default UI preset id for the embedding picker.  Matches
# `trading_crew/embedding_presets.py::BUILTIN_PRESETS`.
TRADINGCREW_DEFAULT_EMBEDDING_PRESET=vllm-embedding

# Max-workers for CrewAI's Memory save pool.  Default is 1 (serial) inside
# CrewAI itself, which queues every analyze call and turns a 5-min run into
# 30 min once you have 100+ saves.  Bumping to 8 lets concurrent
# `remember()` calls fan out so we can saturate the LLM's ~60 req/min
# budget instead of leaving 90 % of the latency on the table.
TRADINGCREW_MEMORY_SAVE_WORKERS=8

# Per-process TTL cache for tool results (seconds).  Several analysts call
# the same tool with identical arguments inside a single workflow — e.g.
# ``get_market_context`` was called 5x by different analysts and
# ``get_indicators`` / ``get_corporate_actions`` 2x each in a verified
# BAJAJ-AUTO.NS run.  All return the same payload within a single run, so
# we cache them at the tool-body level.  Default 600s is comfortably
# longer than any single run; set to 0 to disable (e.g. to confirm a
# regression isn't cache-induced) or 60 if you're iterating on a tool
# implementation and want to see fresh results quickly.
TRADINGCREW_TOOL_CACHE_TTL_SECONDS=600

# --- News / web search ------------------------------------------------------
TAVILY_API_KEY=
SERPAPI_API_KEY=

# =============================================================================
# Indian-market data sources (NSE/BSE-suffixed tickers).
#
# yfinance is fine for most global names but has documented gaps on
# Indian tickers:
#   - Corporate-action adjustments (RAYMOND demerger, HDFCBANK,
#     BAJAJ-AUTO buyback) are frequently mis-applied to Adj Close.
#   - Shareholding pattern (promoter / FII / DII / public) is not
#     exposed at all.
#   - Ind-AS fundamentals are patchy on names outside the top float.
#
# When the flags below are on, the tool layer routes Indian tickers
# (``.NS`` / ``.BO`` suffix) through screener.in (fundamentals +
# announcements + shareholding) and upstox v3 (exchange-clean OHLCV +
# NSE F&O option chain).  Non-Indian tickers ignore both flags and
# stay on yfinance.
# =============================================================================

# screener.in — public company page scraper.  No credentials needed
# for anonymous access; a login lifts anonymous rate limits.  Set the
# flag to ``0`` to force everything back to yfinance (e.g. during a
# screener.in outage).
TRADINGCREW_SCREENER_ENABLED=1

# Optional login for higher screener.in rate limits.  Leave both blank
# to run anonymously — the code degrades to a warning + continues.
SCREENER_EMAIL=
SCREENER_PASSWORD=

# upstox v3 — official NSE/BSE market-data API.  Use the ANALYTICS
# token (1-year, read-only, no daily login round-trip) obtained from
# https://account.upstox.com/developer/apps under the "Analytics" tab.
# Requires an Upstox brokerage account with an active segment.
# Leaving ``UPSTOX_ANALYTICS_TOKEN`` blank disables the upstox path
# entirely (regardless of the enabled flag) so tokenless deployments
# keep working unchanged.
TRADINGCREW_UPSTOX_ENABLED=1
UPSTOX_ANALYTICS_TOKEN=

# =============================================================================
# RLMF (Reinforcement Learning from Market Feedback) — the FinGPT-inspired
# L5 training loop.  When enabled, the crew ranks past *resolved* episodes
# by realised alpha (weighted by conviction + horizon tier) and injects
# the top-K winners + bottom-K losers as a few-shot exemplar block prefixed
# onto the Portfolio Manager task.  This is the *prompt-only* surrogate for
# RLHF-style fine-tuning — it needs no GPU and runs every workflow when the
# episodic memory has resolved outcomes to learn from.
#
# Defaults to OFF because a fresh install has no resolved episodes and the
# prefix would be empty (or worse, misleading with a handful of cherry-picked
# early runs).  Flip it on once ``python -m trading_crew.agentic.rlmf --summary``
# reports ``n_resolved`` >= ~10.
#
# For the full LoRA fine-tune path, run
# ``python -m trading_crew.agentic.rlmf --export`` to write a
# FinGPT-Forecaster-compatible JSONL to ``~/.trading_crew/rlmf/dataset.jsonl``
# and point the standard FinGPT LoRA notebook at that file.
# =============================================================================
TRADINGCREW_RLMF_ENABLED=0
TRADINGCREW_RLMF_K_WINS=3
TRADINGCREW_RLMF_K_LOSSES=2

# --- Telemetry --------------------------------------------------------------
OTEL_SDK_DISABLED=true
CREWAI_DISABLE_TELEMETRY=true

# --- Web UI (optional) ------------------------------------------------------
TRADINGCREW_WEB_HOST=0.0.0.0
TRADINGCREW_WEB_PORT=8001
